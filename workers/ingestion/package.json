{
  "name": "tender-mis-ingestion-worker",
  "version": "1.0.0",
  "description": "Two-tier tender ingestion worker for Rwanda Umucyo OCDS API with portal fallback scraper",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "sync:ocds": "tsx src/index.ts --tier ocds",
    "sync:portal": "tsx src/index.ts --tier portal",
    "sync:all": "tsx src/index.ts --tier all",
    "test": "tsx src/index.ts --test"
  },
  "keywords": ["ocds", "umucyo", "tenders", "rwanda", "ingestion"],
  "author": "MedTender Intelligence MIS",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
